# ⚠️ SECRETS COLLECTION TEMPLATE ⚠️
#
# IMPORTANT SECURITY INSTRUCTIONS:
# 1. Copy this file to .secrets.local (already in .gitignore)
# 2. Fill in your actual values in .secrets.local
# 3. NEVER commit .secrets.local to Git
# 4. After copying secrets to Supabase, DELETE .secrets.local
# 5. Store secrets permanently in a password manager (1Password, Bitwarden, etc.)
#
# To use this template:
#   cp .secrets.template .secrets.local
#   nano .secrets.local  (or use any text editor)
#

# ============================================================================
# PROJECT INFORMATION
# ============================================================================
PROJECT_NAME=Veriff Identity Verification Portal
ENVIRONMENT=Production
DATE_CREATED=
CREATED_BY=

# ============================================================================
# BACKEND SECRETS (Add to Supabase Edge Functions)
# ============================================================================

# 1. ADMIN_PASSWORD
# - Purpose: Password for admin panel login at /admin/login
# - How to create: Choose a strong password (12+ chars, mixed case, numbers, symbols)
# - Example: MySecure!Admin2024
ADMIN_PASSWORD=


# 2. JWT_SECRET
# - Purpose: Secret key for signing admin JWT tokens
# - How to create: Generate 64-char hex string
#   - macOS/Linux: openssl rand -hex 32
#   - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   - Online: https://www.random.org/strings/ (Length=64, Hex)
# - Must be: 64 characters, hexadecimal (0-9, a-f)
JWT_SECRET=


# 3. VERIFF_API_KEY
# - Purpose: API key for creating verification sessions
# - How to get: https://station.veriff.com/ → Settings → Integrations → API Keys
# - Format: UUID format (a1b2c3d4-e5f6-g7h8-i9j0-k1l2m3n4o5p6)
VERIFF_API_KEY=


# 4. VERIFF_API_SECRET
# - Purpose: Secret for verifying webhook signatures
# - How to get: Same location as API Key in Veriff Station
# - Format: Long hexadecimal string
VERIFF_API_SECRET=


# ============================================================================
# FRONTEND CONFIGURATION (Add to .env file)
# ============================================================================

# Supabase Project URL
# - How to get: Supabase Dashboard → Project Settings → API → Project URL
# - Format: https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=


# Supabase Anonymous/Public Key
# - How to get: Supabase Dashboard → Project Settings → API → Project API keys → anon/public
# - Format: Starts with "eyJ..."
# - Note: This is safe to expose in frontend code
VITE_SUPABASE_ANON_KEY=


# ============================================================================
# SUPABASE PROJECT INFO (For Reference)
# ============================================================================

# Supabase Project ID
# - Extract from URL: https://supabase.com/dashboard/project/[PROJECT_ID]
SUPABASE_PROJECT_ID=


# Supabase Database Password
# - This is the password you set when creating the project
# - Only needed for direct database access (not for this app)
# - Store securely, rarely needed
SUPABASE_DB_PASSWORD=


# ============================================================================
# OPTIONAL: VERIFF TEST MODE CREDENTIALS
# ============================================================================
# If you have separate Veriff credentials for testing/staging:

# VERIFF_TEST_API_KEY=
# VERIFF_TEST_API_SECRET=


# ============================================================================
# DEPLOYMENT INFO
# ============================================================================

# Production URL (after deployment)
PRODUCTION_URL=

# Staging URL (if applicable)
STAGING_URL=

